# ==========================================
# CONFIGURACIÓN DEL SISTEMA DE CERTIFICADOS
# ==========================================

# Clave secreta para HMAC-SHA256 (integridad de certificados)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion

# Clave secreta para JWT y sesiones de Flask
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=otra_clave_secreta_diferente_aqui_cambiar_en_produccion

# ==========================================
# BASE DE DATOS
# ==========================================
# SQLite para desarrollo (archivo local)
DATABASE_URL=sqlite:///certificados.db

# PostgreSQL para producción (descomentar y configurar)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/certificados_db

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
FLASK_ENV=development
# FLASK_ENV=production  # Cambiar a production en despliegue

# Puerto del servidor
PORT=5000

# Host
HOST=0.0.0.0

# ==========================================
# RATE LIMITING
# ==========================================
# Límite de solicitudes por minuto para /verify
RATE_LIMIT_PER_MINUTE=10

# ==========================================
# URL BASE PARA VERIFICACIÓN
# ==========================================
# Cambiar por la URL real en producción (con HTTPS obligatorio)
BASE_URL=https://tu-dominio.com

# ==========================================
# CONFIGURACIÓN DE CERTIFICADOS
# ==========================================
# Nombre de la institución por defecto
INSTITUTION_NAME=Nombre de tu Institución

# Duración del certificado en días (0 = sin expiración)
CERTIFICATE_EXPIRY_DAYS=0

# ==========================================
# LOGS
# ==========================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
